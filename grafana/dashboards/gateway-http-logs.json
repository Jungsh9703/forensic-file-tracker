{
  "title": "Gateway HTTP Logs (All Traffic)",
  "uid": "gateway-http-logs",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "identity",
        "label": "User (email, 정규식)",
        "type": "textbox",
        "description": "이메일 일부/전체 입력해서 필터링. 전체 보려면 .* 그대로 두세요 -- identity는 JSON으로 파싱한 필드라 Loki가 자동 드롭다운 목록을 못 만들어줘서 직접 입력 방식입니다.",
        "query": ".*",
        "current": { "text": ".*", "value": ".*" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total requests (selected time range)",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"gateway_http_logs\"} | json | identity=~\"$identity\" [$__range]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requests over time by action",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by (action) (count_over_time({job=\"gateway_http_logs\"} | json | identity=~\"$identity\" [$__interval]))",
          "refId": "A",
          "legendFormat": "{{action}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Top hosts by traffic (selected time range)",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "topk(10, sum by (host) (count_over_time({job=\"gateway_http_logs\"} | json | host != \"\" | identity=~\"$identity\" [$__range])))",
          "refId": "A",
          "legendFormat": "{{host}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Status code distribution (selected time range)",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by (status_code) (count_over_time({job=\"gateway_http_logs\"} | json | status_code != \"\" | identity=~\"$identity\" [$__range]))",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Top blocked/isolated policies (selected time range)",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by (policy_name) (count_over_time({job=\"gateway_http_logs\", action!=\"allow\"} | json | policy_name != \"\" | identity=~\"$identity\" [$__range]))",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Recent log lines",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{job=\"gateway_http_logs\"} | json | identity=~\"$identity\"",
          "refId": "A"
        }
      ]
    }
  ]
}

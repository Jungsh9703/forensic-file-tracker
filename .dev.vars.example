# Copy to .dev.vars for local `wrangler dev`, or fill in via the
# "Deploy to Cloudflare" button's setup screen. Optional -- the Worker runs
# fine without it, it just won't be able to reach a Basic-Auth-protected
# Loki endpoint. (LOKI_USERNAME/CF_ACCOUNT_ID are not secrets -- they live
# in wrangler.toml's [vars] instead, since they're not sensitive.)

# The htpasswd password for LOKI_USERNAME (see ../loki-grafana-azure-vm),
# i.e. the primary auth path for the current no-domain nginx setup.
LOKI_API_KEY=

# Bearer token for GET /forensic/lookup and /forensic/file (src/lookup.ts).
# Those endpoints return real uploaded file contents, so they answer 503
# until this is set -- use any long random string locally.
LOOKUP_TOKEN=

# API token with Account > Zero Trust > Read, paired with wrangler.toml's
# CF_ACCOUNT_ID var. Resolves gateway_http's rule_id -> policy name (and
# DLP profile/entry UUIDs -> names) via the Cloudflare API. Needed in
# practice: PolicyName does NOT always arrive populated in the real log
# (confirmed against real records -- e.g. "bypass" traffic under a system
# policy like "Do Not Inspect" often omits it). Leave blank to just show
# the raw UUID in Grafana for those cases instead.
CF_API_TOKEN=

# Base64 DLP Payload Encryption private key (Zero Trust dashboard ->
# Settings -> DLP -> DLP Payload Encryption public key). Decrypts
# GenAiPromptRequest/Response/Conversation and DLP matched-data context in
# gateway_http logs, IF present -- a real delivered object's full field
# list didn't include either, so this may have no data to act on via
# Logpush (see README). Leave blank to leave those fields null in Grafana.
DLP_PRIVATE_KEY=

# --- Not needed for the current setup -- omitted here so the deploy-button
# screen doesn't prompt for them as if they were required. Add later with
# `wrangler secret put <NAME>` (or the Cloudflare dashboard's Variables and
# Secrets page) if you ever need them -- the code already supports both
# without any further changes:
#   CF_ACCESS_CLIENT_ID / CF_ACCESS_CLIENT_SECRET
#     -- only relevant if a domain + Cloudflare Tunnel + Access fronts Loki
#     instead of the current nginx Basic Auth setup.
#   RUN_TOKEN
#     -- only needed to require a token on the manual POST /run test
#     endpoint; unset just leaves it open to anyone who knows the URL.
